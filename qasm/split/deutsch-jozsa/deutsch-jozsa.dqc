// from: https://en.wikipedia.org/wiki/Deutsch%E2%80%93Jozsa_algorithm

OPENQASM 3.0;
include "stdgates.inc";

// q[3]=ancilla/target
qubit[4] q;
bit[4] c;

barrier q;

// this block is triggered by: (q0=1, q1=1, q2=0)
x q[2];                          // negative control on q2
ctrl(3) @ x q[0], q[1], q[2], q[3];
x q[2];                          // revert q2

barrier q;

// this block is triggered by: (q0=0, q1=0, q2=0)
x q[0];
x q[1];
x q[2];
ctrl(3) @ x q[0], q[1], q[2], q[3];
pragma dqc.v1.split id=1
x q[0];
x q[1];
x q[2];

barrier q;

// this block is triggered by: (q0=0, q1=1, q2=0)
x q[0];
x q[2];
ctrl(3) @ x q[0], q[1], q[2], q[3];
pragma dqc.v1.split id=2
x q[0];
x q[2];

barrier q;

// this block is triggered by: (q0=1, q1=0, q2=1)
x q[1];
ctrl(3) @ x q[0], q[1], q[2], q[3];
x q[1];

barrier q;

c = measure q;