// https://github.com/GFcyborg/dqc

OPENQASM 3.1;
include "stdgates.inc";

qubit[2] q;
bit[2] c;

reset q; //= 00
pragma dqc.v1.split id=1
h q[0]; //= +

x q[1]; //= 1
pragma dqc.v1.split id=2
h q[1]; //= -

// phase kickback:
cx q[0], q[1]; // cx(+-) = --
pragma dqc.v1.split id=3

h q[0]; //= 1
pragma dqc.v1.split id=4
h q[1]; //= 1

// Measure both qubits
c[0] = measure q[0];
c[1] = measure q[1];